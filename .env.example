# The Living Counter v0.9 — Exodia API + Hermes Voice Studio
# The game director on Windows talks to Exodia privately on this PC. Godot never calls Exodia.
EXODIA_ENABLED=1
# 8765 = integrated signed-in Exodia; use 8766 if that is the signed-in Cursor test service.
EXODIA_URL=http://127.0.0.1:8766
EXODIA_PROVIDER=groq
EXODIA_POLL_SECONDS=0.5
EXODIA_TASK_TIMEOUT=85

# Hermes runs independently on your Mac; 8880 is another possible owner port.
HERMES_URL=http://10.0.0.129:8000

# Force deterministic scripted dialogue, e.g. for offline tests.
LIVING_COUNTER_OFFLINE=0
LIVING_COUNTER_DEBUG=0

# Local Windows microphone recognition: NO Anthropic or OpenAI API key needed.
# First launch may download the model; STT_PREWARM loads it while game server starts.
STT_PREWARM=1
STT_MODEL_SIZE=tiny.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# Optional bilingual microphone mode (requires different cached model):
# STT_MODEL_SIZE=base
# STT_LANGUAGE=auto

# groq / gemini-api use Exodia API transport; browser providers are chatgpt, gemini, deepseek.
# Never put provider API keys in the game project. Keep them in Exodia orchestrator/.env.
